# Custom Dataset Class that handles naming variations
class BrainTumorDataset(Dataset):
    def __init__(self, root_dir, transform=None):
        self.root_dir = root_dir
        self.transform = transform
        
        # Standard class names and their indices
        self.class_to_idx = {
            'no_tumor': 0,
            'glioma': 1,
            'meningioma': 2,
            'pituitary': 3
        }
        
        self.idx_to_class = {v: k for k, v in self.class_to_idx.items()}
        self.samples = []
        self._load_samples()
    
    def _normalize_class_name(self, folder_name):
        """Convert any naming variation to standard format"""
        name_lower = folder_name.lower().replace(' ', '_').replace('-', '_')
        
        # Check for no tumor variations
        if any(x in name_lower for x in ['notumor', 'no_tumor', 'normal', 'healthy']):
            return 'no_tumor'
        # Check for glioma
        if any(x in name_lower for x in ['Glioma', 'Glioma_tumor', 'Glioma_Tumor', 'glioma_Tumor','glioma_tumor']):
            return 'glioma'
        # Check for meningioma
        if any(x in name_lower for x in ['Meningioma', 'Meningioma_tumor', 'Meningioma_Tumor', 'meningioma_Tumor','meningioma_tumor']):
            return 'meningioma'
        # Check for pituitary
        elif any(x in name_lower for x in ['Pituitary', 'pituitary_tumor', 'Pituitary_Tumor', 'pituitary_Tumor','pituitary_tumor']):
            return 'pituitary'
        else:
            return None
    
    def _load_samples(self):
        """Load all image samples from the dataset"""
        for class_folder in os.listdir(self.root_dir):
            class_path = os.path.join(self.root_dir, class_folder)
            
            if not os.path.isdir(class_path):
                continue
            
            # Normalize the class name
            standard_name = self._normalize_class_name(class_folder)
            
            if standard_name is None:
                print(f"Warning: Skipping unknown class folder '{class_folder}'")
                continue
            
            class_idx = self.class_to_idx[standard_name]
            
            # Load all images from this folder
            for img_name in os.listdir(class_path):
                img_path = os.path.join(class_path, img_name)
                if img_name.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp', '.tiff')):
                    self.samples.append((img_path, class_idx))
        
        print(f"Loaded {len(self.samples)} samples from {self.root_dir}")
        
        # Print class distribution
        class_counts = {i: 0 for i in range(4)}
        for _, label in self.samples:
            class_counts[label] += 1
        
        print("Class distribution:")
        for idx, count in class_counts.items():
            print(f"  {self.idx_to_class[idx]}: {count} images")
    
    def __len__(self):
        return len(self.samples)
    
    def __getitem__(self, idx):
        img_path, label = self.samples[idx]
        image = Image.open(img_path).convert('RGB')
        
        if self.transform:
            image = self.transform(image)
        
        return image, label
    
    @property
    def classes(self):
        """Return list of class names for compatibility"""
        return [self.idx_to_class[i] for i in range(len(self.class_to_idx))]


# Preparing the data transforms
train_transforms = transforms.Compose([
    transforms.Resize((96, 96)),
    transforms.RandomRotation(10),
