    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406],
                        std=[0.229, 0.224, 0.225])
])

test_transforms = transforms.Compose([
    transforms.Resize((96, 96)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406],
                        std=[0.229, 0.224, 0.225])
])

# Load datasets - Update these paths for Kaggle
# For Kaggle, paths typically look like: '/kaggle/input/dataset-name/Training'
train_dataset = BrainTumorDataset(
    root_dir=r'/kaggle/input/brain-tumor-mri-dataset/Training',
